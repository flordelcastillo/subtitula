# Clave de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Protege la ingesta de workers, el envío de audio y la edición del glosario.
# Obligatorio con Docker Compose: poné una contraseña larga.
SUBTITULA_TOKEN=
# URL pública del hub, se usa en los QR.
SUBTITULA_PUBLIC_URL=http://localhost:8000
# Opcionales: modelos de transcripción y de traducción (listas separadas por coma).
# SUBTITULA_ASR_MODEL=gemini-3.5-transcribe
# SUBTITULA_GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
